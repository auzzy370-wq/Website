# Required on Vercel / production (Neon pooled URL recommended)
DATABASE_URL=postgresql://user:pass@host/db?sslmode=require

# Optional: direct (non-pooled) URL for migrations if using Neon pooler
# DATABASE_URL_UNPOOLED=postgresql://user:pass@host/db?sslmode=require

# Public site URL (set after first deploy)
NEXT_PUBLIC_APP_URL=https://your-app.vercel.app

# Optional integrations
GOLD_API_KEY=
DEALER_ADMIN_SECRET=
STRIPE_SECRET_KEY=
